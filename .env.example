PORT=8888
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
TELEGRAM_BOT_TOKEN=<telegram-bot-token-from-botfather>

# Random secret we generate
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=<random-hex-string>

ANTHROPIC_API_KEY=<anthropic-api-key>
MODEL=claude-haiku-4-5-20251001

OPENAI_API_KEY=<openai-api-key>

SUPERMEMORY_API_KEY=<supermemory-api-key>

BASE_URL=https://ngrok-tunnel-or-domain.example.com
