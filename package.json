  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "NODE_ENV=production tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "set-webhook": "tsx src/scripts/setTGWebhook.ts",
    "add-test-data": "tsx src/scripts/addTestData.ts"
  },
